{
  "name": "lah-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --outfile=dist/worker.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "dev": "npm run build && node scripts/preview.mjs",
    "migrate:archive": "node scripts/migrate-archive.mjs",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "fuse.js": "^7.0.0",
    "hono": "^4.0.0",
    "jose": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "esbuild": "^0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.131.1"
  },
  "overrides": {
    "miniflare@4.20260730.0": {
      "undici": "^7.29.0",
      "sharp": "^0.35.4"
    }
  },
  "engines": {
    "node": ">=24 <27"
  }
}
