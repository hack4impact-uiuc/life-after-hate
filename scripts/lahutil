#!/usr/bin/env node
const { spawn } = require("node:child_process");
const path = require("node:path");
const root = path.resolve(__dirname, "..");
const [command, ...args] = process.argv.slice(2);
function run(executable, argv, env = {}) {
  const child = spawn(executable, argv, { cwd: root, stdio: "inherit", env: { ...process.env, ...env } });
  child.on("error", () => { console.error("Command could not start"); process.exitCode = 1; });
  child.on("exit", (code) => { process.exitCode = code ?? 1; });
}
switch (command) {
  case "up": {
    const roles = { "--admin": "ADMIN", "--volunteer": "VOLUNTEER", "--pending": "PENDING", "--rejected": "REJECTED" };
    run("docker", ["compose", "up", "--build"], { BYPASS_AUTH_ROLE: roles[args[0]] || "" });
    break;
  }
  case "down": run("docker", ["compose", "down"]); break;
  case "reset": run("docker", ["compose", "build", "--pull"]); break;
  case "seed":
    if (!args.includes("--confirm-local-data-loss")) {
      console.error("Seeding replaces the local database. Pass --confirm-local-data-loss for a disposable local database.");
      process.exitCode = 1;
    } else run("docker", ["compose", "run", "--rm", "-e", "ALLOW_DESTRUCTIVE_SEED=yes-local-only", "backend", "node", "utils/generate_mock_data.js"]);
    break;
  case "test": run("npm", ["--prefix", "backend", "test"]); break;
  case "testfe": run("npm", ["--prefix", "frontend", "run", "test:e2e"]); break;
  default:
    console.info("Usage: lahutil up [--admin|--volunteer|--pending|--rejected] | down | reset | seed --confirm-local-data-loss | test | testfe");
    if (command) process.exitCode = 1;
}
